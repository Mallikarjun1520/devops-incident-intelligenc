# Groq API key — never commit your real .env
GROQ_API_KEY=

# Groq model used for incident reasoning
GROQ_MODEL=openai/gpt-oss-20b

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB location
CHROMA_PATH=./chroma_db

# Number of similar incidents retrieved
TOP_K=3

# Minimum similarity threshold
MIN_SIMILARITY=0.30